<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>주식 단타 시뮬레이터 v4.2 (3단계 티어제 뉴스 시스템)</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Bebas+Neue&family=Noto+Sans+KR:wght(300;400;600;700;900)&display=swap');

:root {
  --bg:       #07090f;
  --panel:    #0c0f1a;
  --card:     #101422;
  --border:   #1a2035;
  --border2:  #222840;
  --accent:   #4fc3f7;
  --green:    #00e676;
  --red:      #ff1744;
  --yellow:   #ffd740;
  --purple:   #ea80fc;
  --text:     #cdd6f4;
  --dim:      #4a5580;
  --dim2:     #2a3350;
  --mono:     'Share Tech Mono', monospace;
  --sans:     'Noto Sans KR', sans-serif;
  --display:  'Bebas Neue', cursive;
}

*{margin:0;padding:0;box-sizing:border-box;}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

body::after {
  content:''; position:fixed; inset:0;
  background: repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.08) 3px);
  pointer-events:none; z-index:1000;
}

/* HEADER */
#header {
  z-index:10; display:flex; align-items:center; gap:0; padding:0 20px;
  height:52px; border-bottom:1px solid var(--border);
  background: rgba(12,15,26,0.97); backdrop-filter:blur(12px); flex-shrink:0;
}
#logo {
  font-family: var(--display); font-size:22px; letter-spacing:3px; color: var(--accent);
  text-shadow: 0 0 20px rgba(79,195,247,0.5); margin-right:20px; white-space:nowrap;
}
#header-divider { width:1px; height:28px; background: var(--border2); margin-right:20px; }

.h-stat { display:flex; flex-direction:column; align-items:flex-start; margin-right:24px; }
.h-stat-label { font-family: var(--mono); font-size:9px; letter-spacing:2px; color: var(--dim); text-transform:uppercase; }
.h-stat-value { font-family: var(--mono); font-size:18px; line-height:1.1; transition: color .3s, text-shadow .3s; }
#price-el    { color: var(--text); }
#returns-el  { color: var(--text); }
#assets-el   { color: var(--accent); text-shadow: 0 0 16px rgba(79,195,247,0.4); }
#principal-el { color: var(--text); opacity: 0.9; }
#leverage-el { color: var(--yellow); }

.h-stat-value.up   { color: var(--green) !important; text-shadow: 0 0 14px rgba(0,230,118,0.5) !important; }
.h-stat-value.dn   { color: var(--red)   !important; text-shadow: 0 0 14px rgba(255,23,68,0.4) !important; }

/* 차트 변경 토글 UI 추가 */
#chart-toggle {
  margin-left: auto;
  margin-right: 14px;
  background: transparent;
  border: 1px solid var(--border2);
  color: var(--dim);
  font-family: var(--sans);
  font-size: 11px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.2s;
}
#chart-toggle:hover {
  border-color: var(--accent);
  color: var(--accent);
}
#chart-toggle.active-line {
  color: var(--text);
  border-color: var(--text);
  background: rgba(255,255,255,0.05);
}

#live-wrap {
  display:flex; align-items:center; gap:6px;
  font-family: var(--mono); font-size:10px; letter-spacing:2px; color: var(--dim);
}
#live-dot {
  width:7px; height:7px; border-radius:50%; background: var(--green);
  box-shadow: 0 0 8px var(--green); animation: blink 1.1s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.2} }

/* CHART */
#chart-wrap { flex:1; position:relative; z-index:5; overflow:hidden; min-height:0; }
#chart { display:block; width:100%; height:100%; }

/* BOTTOM PANEL */
#bottom {
  z-index:10; display:flex; align-items:stretch; gap:12px; padding:12px 20px 14px;
  border-top:1px solid var(--border); background: rgba(12,15,26,0.98); flex-shrink:0;
}
.btn-trade {
  flex:1; padding:16px 0; font-family: var(--mono); font-size:14px; letter-spacing:3px;
  border:none; cursor:pointer; text-transform:uppercase; position:relative; overflow:hidden;
  transition: all .15s; clip-path: polygon(8px 0%,100% 0%,calc(100% - 8px) 100%,0% 100%);
}
.btn-trade:active { transform:scale(.97); }
.btn-trade:disabled { opacity:.2; cursor:not-allowed; transform:none !important; }

#btn-buy { background: rgba(0,230,118,0.09); color: var(--green); border:1px solid rgba(0,230,118,0.28); }
#btn-buy:hover:not(:disabled) { background: rgba(0,230,118,0.18); box-shadow: 0 0 28px rgba(0,230,118,0.25); }
#btn-buy.lock-disabled {
  background: rgba(0, 230, 118, 0.03) !important; color: var(--green) !important;
  border: 1px solid rgba(0, 230, 118, 0.1) !important; opacity: 0.35 !important; cursor: not-allowed !important;
}
#btn-sell { background: rgba(255,23,68,0.09); color: var(--red); border:1px solid rgba(255,23,68,0.28); }
#btn-sell:hover:not(:disabled) { background: rgba(255,23,68,0.18); box-shadow: 0 0 28px rgba(255,23,68,0.25); }

#hold-strip {
  display:flex; align-items:center; gap:16px; padding:0 16px; background: rgba(255,215,64,0.05);
  border:1px solid rgba(255,215,64,0.15); border-radius:4px; min-width:200px; opacity:0; transition:opacity .4s;
}
#hold-strip.visible { opacity:1; }
.hs-item { display:flex; flex-direction:column; align-items:flex-start; }
.hs-label { font-family:var(--mono); font-size:8px; letter-spacing:2px; color:var(--dim); text-transform:uppercase; }
.hs-val   { font-family:var(--mono); font-size:13px; color:var(--yellow); }

/* NEWS BANNER */
#news-banner {
  position:fixed; top: 60px; left:50%; transform:translateX(-50%) translateY(-120px); z-index:500;
  width:min(640px, 92vw); border-radius:6px; backdrop-filter:blur(16px);
  transition: transform .45s cubic-bezier(.34,1.4,.64,1), opacity .4s; opacity:0; pointer-events:none;
}
#news-banner.show { transform: translateX(-50%) translateY(0); opacity:1; }

#news-body { position: relative; z-index: 3; padding:16px 22px; border-radius:6px; width: 100%; }
#news-banner.bull #news-body { background: rgba(0,20,10,0.95); border:1px solid rgba(0,230,118,0.5); box-shadow: 0 8px 48px rgba(0,230,118,0.25), 0 0 0 1px rgba(0,230,118,0.1); }
#news-banner.bear #news-body { background: rgba(20,5,8,0.95); border:1px solid rgba(255,23,68,0.5); box-shadow: 0 8px 48px rgba(255,23,68,0.25), 0 0 0 1px rgba(255,23,68,0.1); }
#news-banner.bull.massive #news-body { background: rgba(0,30,15,0.97); border:2px solid rgba(0,230,118,0.9); box-shadow: 0 8px 64px rgba(0,230,118,0.5), 0 0 0 1px rgba(0,230,118,0.3); }
#news-banner.bear.massive #news-body { background: rgba(30,5,8,0.97); border:2px solid rgba(255,23,68,0.9); box-shadow: 0 8px 64px rgba(255,23,68,0.5), 0 0 0 1px rgba(255,23,68,0.3); }

#news-tag { font-family: var(--mono); font-size:10px; letter-spacing:3px; text-transform:uppercase; margin-bottom:6px; }
.bull #news-tag { color: var(--green); } .bear #news-tag { color: var(--red); }
.massive #news-tag { font-size:12px; letter-spacing:4px; font-weight:900; }
#news-headline { font-size:15px; font-weight:700; line-height:1.4; color: var(--text); }
.massive #news-headline { font-size:17px; }
#news-effect { font-family: var(--mono); font-size:11px; margin-top:6px; opacity:.7; }
.bull #news-effect { color: var(--green); } .bear #news-effect { color: var(--red); }
.massive #news-effect { opacity:1; font-size:13px; font-weight:900; }

/* TOAST */
#toast {
  position:fixed; bottom:90px; left:50%; transform: translateX(-50%) translateY(20px); z-index:600; font-family: var(--mono); font-size:20px;
  letter-spacing:2px; padding:14px 40px 12px; border:1px solid; text-align:center; opacity:0; pointer-events:none; transition: all .25s cubic-bezier(.34,1.4,.64,1);
  backdrop-filter:blur(12px); clip-path: polygon(12px 0%,100% 0%,calc(100% - 12px) 100%,0% 100%);
}
#toast.show { opacity:1; transform: translateX(-50%) translateY(0); }
#toast.profit { color:var(--green); border-color:rgba(0,230,118,.5); background:rgba(0,230,118,.08); box-shadow:0 0 40px rgba(0,230,118,.2); }
#toast.loss   { color:var(--red);   border-color:rgba(255,23,68,.5);  background:rgba(255,23,68,.08);  box-shadow:0 0 40px rgba(255,23,68,.2);  }
#toast-sub { font-size:12px; opacity:.8; margin-top:4px; letter-spacing:1px; }

/* FLASH */
#flash { position:fixed; inset:0; pointer-events:none; z-index:300; opacity:0; transition:opacity .12s; }

/* SHOP SYSTEM */
#shop-btn {
  position:fixed; right:20px; bottom:80px; width:56px; height:56px; border-radius:50%; border:none; cursor:pointer; z-index:200;
  background: linear-gradient(135deg,#1a2a4a,#0d1a30); border:1.5px solid rgba(79,195,247,0.4);
  box-shadow: 0 4px 24px rgba(0,0,0,0.6), 0 0 20px rgba(79,195,247,0.15); font-size:24px; display:flex;align-items:center;justify-content:center; transition: all .2s;
}
#shop-btn:hover { transform:scale(1.1); box-shadow: 0 6px 32px rgba(0,0,0,0.6), 0 0 32px rgba(79,195,247,0.35); border-color: rgba(79,195,247,0.7); }
#shop-btn:active { transform:scale(.95); }

#shop-overlay { position:fixed; inset:0; z-index:400; background: rgba(0,0,0,0.7); backdrop-filter:blur(6px); opacity:0; pointer-events:none; transition:opacity .3s; }
#shop-overlay.open { opacity:1; pointer-events:all; }

#shop-modal {
  position: absolute; top: 50%; left: 50%; width: 380px; max-width: 92vw; max-height: 80vh;
  background: var(--card); border: 1px solid var(--border2); border-radius: 12px;
  box-shadow: 0 24px 80px rgba(0,0,0,0.8), 0 0 0 1px rgba(79,195,247,0.06);
  transform: translate(-50%, -50%) scale(0.92);
  transition: transform .35s cubic-bezier(.34,1.4,.64,1), opacity .3s; opacity: 0;
  display: flex; flex-direction: column; overflow: hidden;
}
#shop-overlay.open #shop-modal { transform: translate(-50%, -50%) scale(1); opacity: 1; }

#shop-header { display:flex; flex-direction:column; border-bottom:1px solid var(--border); flex-shrink: 0; }
.shop-header-top { display:flex; align-items:center; justify-content:space-between; padding:16px 18px 10px; }
#shop-title { font-family: var(--display); font-size:20px; letter-spacing:3px; color: var(--accent); }
#shop-close { width:28px;height:28px;border-radius:50%; background:var(--border);border:none; color:var(--dim);font-size:16px;cursor:pointer; display:flex;align-items:center;justify-content:center; transition:all .15s; }
#shop-close:hover { background:var(--border2); color:var(--text); }

/* TABS */
.shop-tabs { display:flex; gap:0; padding:0 18px; margin-bottom: 8px; }
.shop-tab {
  flex:1; background:transparent; border:none; color:var(--dim); font-size:12px; font-weight:700;
  padding:10px 0; cursor:pointer; border-bottom:2px solid transparent; transition:all .2s;
}
.shop-tab.active { color:var(--text); border-bottom-color:var(--accent); text-shadow: 0 0 10px rgba(79,195,247,0.5); }

#shop-cash { padding:10px 18px; background:rgba(79,195,247,0.05); border-bottom:1px solid var(--border); font-family:var(--mono); font-size:11px; color:var(--dim); display:flex;gap:6px;align-items:center; flex-shrink: 0; }
#shop-cash-val { color:var(--accent); font-size:14px; }
#shop-items { padding:12px; display:flex; flex-direction:column; gap:8px; flex: 1; overflow-y:auto; }
#shop-items::-webkit-scrollbar { width:4px; }
#shop-items::-webkit-scrollbar-thumb { background:var(--border2); border-radius:2px; }

.shop-item { background: rgba(255,255,255,0.03); border:1px solid var(--border); border-radius:8px; padding:12px 14px; transition: all .2s; position:relative; }
.item-row { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.item-icon { font-size:24px; flex-shrink:0; text-align:center; width: 32px; }
.item-info { flex:1; min-width:0; }
.item-name { font-size:13px; font-weight:700; color:var(--text); margin-bottom:2px; display: flex; align-items: center; gap: 6px; }
.item-desc { font-size:11px; color:var(--dim); line-height:1.4; }
.item-buy-btn { font-family:var(--mono); font-size:11px; padding:8px 12px; border:none; border-radius:4px; cursor:pointer; white-space:nowrap; flex-shrink:0; transition:all .15s; letter-spacing:1px; position:relative; overflow:hidden; min-width: 65px;}
.item-buy-btn.yellow-btn { background:rgba(255,215,64,0.1); color:var(--yellow); border:1px solid rgba(255,215,64,0.25); }
.item-buy-btn.yellow-btn:hover:not(:disabled) { background:rgba(255,215,64,0.2); }
.item-buy-btn:disabled { opacity:.4; cursor:not-allowed; }
.item-price { font-family:var(--mono); font-size:11px; color:var(--yellow); margin-top:4px; }

#lev-badge {
  position:absolute; top:10px;left:12px; z-index:20; font-family:var(--mono); font-size:11px; letter-spacing:2px; color:var(--yellow);
  background:rgba(255,215,64,0.1); border:1px solid rgba(255,215,64,0.25); padding:3px 8px; border-radius:3px; opacity:0; transition:opacity .3s;
}
#lev-badge.visible { opacity:1; }

/* ── DEPARTMENT UPGRADE SYSTEM CSS ── */
.level-badge { background: #222840; color: #fff; font-size: 10px; padding: 2px 6px; border-radius: 4px; font-weight: 900; }
.prob-text { font-size: 10px; color: var(--accent); margin-top: 4px; font-weight: 600;}

/* Tier 0 (0강) */
.tier-0 { border-color: #222840; }
/* Tier 1 (1강: Deep Brown/Bronze) */
.tier-1 { border-color: #a0522d; box-shadow: 0 0 8px rgba(160, 82, 45, 0.3); }
.tier-1 .level-badge { background: #8B5A2B; color: #fff; }
/* Tier 2 (2강: Silver Metallic) */
.tier-2 { border-color: #b4b4b4; box-shadow: 0 0 10px rgba(180, 180, 180, 0.25); }
.tier-2 .level-badge { background: linear-gradient(135deg, #e0e0e0, #b4b4b4); color: #222; text-shadow: none; }
/* Tier 3 (3강: Gold) */
.tier-3 { border-color: #ffd700; box-shadow: 0 0 12px rgba(255, 215, 0, 0.3); }
.tier-3 .level-badge { background: #ffd700; color: #000; text-shadow: none; }
/* Tier 4 (4강: Golden Aura) */
@keyframes goldBorder {
  0%   { border-color: #ffd700; box-shadow: 0 0 10px rgba(255,215,0,0.45), inset 0 0 4px rgba(255,215,0,0.08); }
  20%  { border-color: #ffe55c; box-shadow: 0 0 22px rgba(255,229,92,0.75),  inset 0 0 10px rgba(255,229,92,0.15); }
  40%  { border-color: #ffb300; box-shadow: 0 0 28px rgba(255,179,0,0.8),   inset 0 0 14px rgba(255,179,0,0.18); }
  60%  { border-color: #ffd700; box-shadow: 0 0 36px rgba(255,215,0,0.9),   inset 0 0 18px rgba(255,215,0,0.2); }
  80%  { border-color: #ffe082; box-shadow: 0 0 20px rgba(255,224,130,0.65), inset 0 0 8px rgba(255,224,130,0.12); }
  100% { border-color: #ffd700; box-shadow: 0 0 10px rgba(255,215,0,0.45),  inset 0 0 4px rgba(255,215,0,0.08); }
}
@keyframes goldBg {
  0%,100% { background: rgba(255,215,0,0.03); }
  50%      { background: rgba(255,193,7,0.07); }
}
@keyframes goldShine {
  0%   { transform: translateX(-140%) rotate(28deg); opacity: 0; }
  18%  { opacity: 0.55; }
  82%  { opacity: 0.55; }
  100% { transform: translateX(140%) rotate(28deg); opacity: 0; }
}
@keyframes goldBadge {
  0%,100% { background: #ffd700; color: #000; box-shadow: 0 0 6px rgba(255,215,0,0.5); }
  50%      { background: #ffe55c; color: #000; box-shadow: 0 0 14px rgba(255,229,92,0.9); }
}
.tier-4 {
  border: 1.5px solid #ffd700;
  animation: goldBorder 5.0s ease-in-out infinite, goldBg 5.0s ease-in-out infinite;
  overflow: hidden;
  position: relative;
}
.tier-4 .level-badge { animation: goldBadge 5.0s ease-in-out infinite; }
.tier-4::after {
  content: ""; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
  background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,240,100,0.28) 45%, rgba(255,255,255,0.18) 50%, rgba(255,240,100,0.28) 55%, rgba(255,255,255,0) 100%);
  animation: goldShine 5.0s ease-in-out infinite; pointer-events: none;
}

/* Tier 5 (5강: Cyber Fantasy MAX Aura) */
@keyframes tier5Border {
  0%   { border-color: #ff00de; box-shadow: 0 0 14px rgba(255,0,222,0.55), 0 0 32px rgba(255,0,222,0.2), inset 0 0 10px rgba(255,0,222,0.08); }
  33%  { border-color: #bf00ff; box-shadow: 0 0 20px rgba(191,0,255,0.7),  0 0 48px rgba(191,0,255,0.25), inset 0 0 16px rgba(191,0,255,0.12); }
  66%  { border-color: #7b2fff; box-shadow: 0 0 18px rgba(123,47,255,0.65), 0 0 40px rgba(123,47,255,0.22), inset 0 0 14px rgba(123,47,255,0.1); }
  100% { border-color: #ff00de; box-shadow: 0 0 14px rgba(255,0,222,0.55), 0 0 32px rgba(255,0,222,0.2), inset 0 0 10px rgba(255,0,222,0.08); }
}
@keyframes tier5Bg {
  0%   { background: rgba(255,0,222,0.04); }
  50%  { background: rgba(123,47,255,0.09); }
  100% { background: rgba(255,0,222,0.04); }
}
@keyframes tier5Plasma {
  0%   { transform: translateX(-100%) skewX(-15deg); opacity:0; }
  15%  { opacity: 0.6; }
  85%  { opacity: 0.6; }
  100% { transform: translateX(100%) skewX(-15deg); opacity:0; }
}
@keyframes tier5PlasmaB {
  0%   { transform: translateX(100%) skewX(15deg); opacity:0; }
  15%  { opacity: 0.4; }
  85%  { opacity: 0.4; }
  100% { transform: translateX(-100%) skewX(15deg); opacity:0; }
}
@keyframes tier5Ember1 {
  0%   { transform: translate(0px,    0px) scale(0);   opacity: 0; }
  8%   { transform: translate(-2px,  -4px) scale(1);   opacity: 0.9; }
  85%  { transform: translate(-16px,-30px) scale(0.4); opacity: 0.3; }
  100% { transform: translate(-20px,-38px) scale(0);   opacity: 0; }
}
@keyframes tier5Ember2 {
  0%   { transform: translate(0px,   0px) scale(0);   opacity: 0; }
  8%   { transform: translate(2px,  -3px) scale(1);   opacity: 0.85; }
  85%  { transform: translate(14px,-28px) scale(0.4); opacity: 0.25; }
  100% { transform: translate(18px,-36px) scale(0);   opacity: 0; }
}
@keyframes tier5Ember3 {
  0%   { transform: translate(0px,   0px) scale(0);   opacity: 0; }
  8%   { transform: translate(-1px, -4px) scale(1);   opacity: 1; }
  85%  { transform: translate(-9px,-26px) scale(0.5); opacity: 0.35; }
  100% { transform: translate(-12px,-34px) scale(0);  opacity: 0; }
}
@keyframes tier5Ember4 {
  0%   { transform: translate(0px,   0px) scale(0);   opacity: 0; }
  8%   { transform: translate(3px,  -3px) scale(1);   opacity: 0.8; }
  85%  { transform: translate(20px,-22px) scale(0.4); opacity: 0.2; }
  100% { transform: translate(24px,-30px) scale(0);   opacity: 0; }
}

/* Tier5 ember spark particles */
.tier-5 .t5-ember {
  position: absolute; width: 4px; height: 4px; border-radius: 50%; pointer-events: none; z-index: 10;
  opacity: 0;
  background: radial-gradient(circle, #fff 0%, #ff00de 50%, transparent 100%);
}
/* Tier5 ember spark particles */
.tier-5 .t5-ember {
  position: absolute; width: 4px; height: 4px; border-radius: 50%; pointer-events: none; z-index: 10;
  opacity: 0;
  background: radial-gradient(circle, #fff 0%, #ff00de 50%, transparent 100%);
}
.tier-5 .t5-ember:nth-child(1) { bottom: 6px; left: 18%;  animation: tier5Ember1 4.0s ease-in-out infinite 0.0s; }
.tier-5 .t5-ember:nth-child(2) { bottom: 6px; left: 58%;  animation: tier5Ember2 4.8s ease-in-out infinite 0.9s; background: radial-gradient(circle, #fff 0%, #bf00ff 50%, transparent 100%); }
.tier-5 .t5-ember:nth-child(3) { bottom: 6px; left: 38%;  animation: tier5Ember3 3.6s ease-in-out infinite 1.8s; }
.tier-5 .t5-ember:nth-child(4) { bottom: 6px; left: 78%;  animation: tier5Ember4 4.4s ease-in-out infinite 0.5s; background: radial-gradient(circle, #fff 0%, #7b2fff 50%, transparent 100%); }
.tier-5 .t5-ember:nth-child(5) { bottom: 6px; left:  8%;  animation: tier5Ember2 5.0s ease-in-out infinite 2.4s; background: radial-gradient(circle, #fff 0%, #ff00de 50%, transparent 100%); }
.tier-5 .t5-ember:nth-child(6) { bottom: 6px; left: 68%;  animation: tier5Ember1 4.2s ease-in-out infinite 1.3s; background: radial-gradient(circle, #fff 0%, #bf00ff 50%, transparent 100%); }

@keyframes tier5BadgePulse {
  0%,100% { background: linear-gradient(135deg,#ff00de,#bf00ff); box-shadow: 0 0 10px rgba(255,0,222,0.7); color:#fff; }
  50%      { background: linear-gradient(135deg,#7b2fff,#ff00de); box-shadow: 0 0 18px rgba(123,47,255,0.9); color:#fff; }
}
@keyframes tier5NameGlow {
  0%,100% { text-shadow: 0 0 6px rgba(255,0,222,0.8), 0 0 14px rgba(255,0,222,0.4); color: #ff88f0; }
  50%      { text-shadow: 0 0 10px rgba(123,47,255,1),  0 0 24px rgba(191,0,255,0.5); color: #c988ff; }
}

.tier-5 {
  border: 1.5px solid #ff00de;
  animation: tier5Border 4.5s ease-in-out infinite, tier5Bg 4.5s ease-in-out infinite;
  overflow: hidden;
  position: relative;
}
.tier-5::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  overflow: hidden; border-radius: inherit; pointer-events: none; z-index: 1;
  background:
    linear-gradient(90deg, transparent 0%, rgba(255,0,222,0.18) 40%, rgba(123,47,255,0.18) 60%, transparent 100%);
  animation: tier5Plasma 4.0s ease-in-out infinite;
}
.tier-5::after {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  overflow: hidden; border-radius: inherit; pointer-events: none; z-index: 1;
  background:
    linear-gradient(90deg, transparent 0%, rgba(191,0,255,0.12) 40%, rgba(255,0,222,0.15) 60%, transparent 100%);
  animation: tier5PlasmaB 5.2s ease-in-out infinite;
}
.tier-5 .level-badge {
  animation: tier5BadgePulse 4.5s ease-in-out infinite;
  color: #fff;
}
.tier-5 .item-name {
  animation: tier5NameGlow 4.5s ease-in-out infinite;
}
.tier-5 .item-buy-btn { opacity: 0; pointer-events: none; }

/* 강화 이펙트 */
@keyframes upgradeTension {
  0%   { transform: translate(0, 0);          filter: brightness(1); }
  20%  { transform: translate(-0.5px, 0.5px); filter: brightness(0.95); }
  40%  { transform: translate(0.5px, -0.5px); filter: brightness(1.05); }
  60%  { transform: translate(-0.5px, 0);     filter: brightness(0.95); }
  80%  { transform: translate(0.5px, 0.5px);  filter: brightness(1.05); }
  100% { transform: translate(0, 0);          filter: brightness(4); }
}

@keyframes upgradeNeonScan {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes upgradeChromaShift {
  0%   { text-shadow: -2px 0 #ff00de, 2px 0 #00ffff; opacity: 1; }
  25%  { text-shadow: 2px 0 #ff0055, -2px 0 #00ff99; opacity: 0.85; }
  50%  { text-shadow: -3px 0 #ffee00, 3px 0 #7700ff; opacity: 1; }
  75%  { text-shadow: 3px 0 #00ffff, -3px 0 #ff00de; opacity: 0.9; }
  100% { text-shadow: -2px 0 #ff00de, 2px 0 #00ffff; opacity: 1; }
}

@keyframes upgradeBorderPulse {
  0%   { box-shadow: 0 0 8px rgba(79,195,247,0.3), inset 0 0 8px rgba(79,195,247,0.1); }
  33%  { box-shadow: 0 0 24px rgba(255,0,222,0.6), inset 0 0 16px rgba(255,0,222,0.2); border-color: #ff00de; }
  66%  { box-shadow: 0 0 24px rgba(0,255,255,0.6), inset 0 0 16px rgba(0,255,255,0.2); border-color: #00ffff; }
  100% { box-shadow: 0 0 8px rgba(79,195,247,0.3), inset 0 0 8px rgba(79,195,247,0.1); }
}

.item-upgrading {
  animation: upgradeTension 1.5s cubic-bezier(.36,.07,.19,.97) forwards,
             upgradeBorderPulse 0.35s linear infinite;
  pointer-events: none;
  position: relative;
  overflow: hidden;
}
.item-upgrading::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(79,195,247,0.18) 40%, rgba(255,0,222,0.18) 60%, transparent 100%);
  background-size: 200% 100%;
  animation: upgradeNeonScan 0.5s linear infinite;
  pointer-events: none;
  z-index: 5;
}
.item-upgrading .item-name {
  animation: upgradeChromaShift 0.3s linear infinite;
}

/* ── OPERATOR EVENT & FAKE NEWS STYLES ── */
#operator-warning {
  position: absolute; top: 38%; left: 50%; transform: translate(-50%, -50%);
  z-index: 50; pointer-events: none; text-align: center; opacity: 0;
  transition: opacity 0.2s;
  width: 90%;
}
#operator-warning.show { opacity: 1; }

@keyframes glitchText {
  0%   { text-shadow: -3px 0 #ff0, 3px 0 #f00; skewX(0deg); }
  10%  { text-shadow: 3px 0 #0ff, -3px 0 #ff0; }
  20%  { text-shadow: -3px 0 #f0f, 3px 0 #0ff; clip-path: inset(5% 0 5% 0); }
  30%  { text-shadow: 3px 0 #ff0, -3px 0 #f0f; clip-path: inset(0); }
  40%  { text-shadow: -4px 0 #0ff, 4px 0 #ff0; }
  50%  { text-shadow: 4px 0 #f00, -4px 0 #0ff; clip-path: inset(10% 0 10% 0); }
  60%  { text-shadow: -2px 0 #ff0, 2px 0 #f0f; clip-path: inset(0); }
  70%  { text-shadow: 2px 0 #0ff, -2px 0 #f00; }
  80%  { text-shadow: -3px 0 #f0f, 3px 0 #ff0; clip-path: inset(2% 0 2% 0); }
  90%  { text-shadow: 3px 0 #f00, -3px 0 #0ff; clip-path: inset(0); }
  100% { text-shadow: -3px 0 #ff0, 3px 0 #f00; }
}

@keyframes warnBlink {
  0%,100% { opacity:1; } 50% { opacity:0.4; }
}

#operator-warning .warn-text {
  font-family: var(--display); font-size: clamp(18px, 3vw, 28px); letter-spacing: 3px;
  color: #ffd700;
  animation: glitchText 0.4s infinite, warnBlink 0.6s infinite;
  display: block;
}
#operator-warning .warn-sub {
  font-family: var(--mono); font-size: 12px; color: #ff4444; letter-spacing: 4px;
  margin-top: 6px; display: block;
  animation: warnBlink 0.4s infinite;
}

@keyframes feverGlow {
  0%,100% { background: rgba(255,215,0,0); }
  50%      { background: rgba(255,215,0,0.15); }
}
#chart-wrap.fever { animation: feverGlow 0.4s ease-in-out infinite; }

@keyframes bloodFlash {
  0%   { background: rgba(255,0,0,0.0); }
  15%  { background: rgba(255,0,0,0.7); }
  35%  { background: rgba(180,0,0,0.5); }
  55%  { background: rgba(255,0,0,0.65); }
  70%  { background: rgba(140,0,0,0.3); }
  100% { background: rgba(255,0,0,0.0); }
}
#flash.blood { animation: bloodFlash 0.5s ease-out forwards !important; }

@keyframes chartPanic {
  0%  { transform: translate(0,0) rotate(0deg); }
  10% { transform: translate(-10px,-8px) rotate(-1.5deg); }
  20% { transform: translate(12px,10px) rotate(1.5deg); }
  30% { transform: translate(-14px,6px) rotate(-1deg); }
  40% { transform: translate(14px,-10px) rotate(1deg); }
  50% { transform: translate(-8px,12px) rotate(-1.5deg); }
  60% { transform: translate(10px,-8px) rotate(1deg); }
  70% { transform: translate(-12px,4px) rotate(-0.5deg); }
  80% { transform: translate(8px,-6px) rotate(0.5deg); }
  90% { transform: translate(-4px,4px) rotate(0deg); }
  100%{ transform: translate(0,0) rotate(0deg); }
}
#chart-wrap.panic { animation: chartPanic 0.55s cubic-bezier(.36,.07,.19,.97) both; }

/* 작전세력 등장확률 배지 */
#operator-prob {
  position: absolute; top: 10px; left: 90px; z-index: 20;
  font-family: var(--mono); font-size: 11px; letter-spacing: 1px;
  color: #ff4444; background: rgba(255,20,20,0.08);
  border: 1px solid rgba(255,20,20,0.25); padding: 3px 8px; border-radius: 3px;
  display: none;
}

/* 거짓뉴스 배너 특수 스타일 */
#news-banner.fake #news-body {
  background: rgba(30,0,0,0.97) !important;
  border: 2px solid rgba(255,23,68,0.95) !important;
  box-shadow: 0 8px 64px rgba(255,23,68,0.7), 0 0 0 2px rgba(255,0,0,0.5) !important;
}
#news-banner.fake #news-tag { color: #ff1744 !important; animation: warnBlink 0.5s infinite; }
@keyframes bearShake {
  0% { transform: translate(0, 0) rotate(0deg); } 20% { transform: translate(-6px, -4px) rotate(-1deg); }
  40% { transform: translate(8px, -4px) rotate(1deg); } 60% { transform: translate(-5px, 6px) rotate(-1deg); }
  80% { transform: translate(5px, 4px) rotate(1deg); } 100% { transform: translate(0, 0) rotate(0deg); }
}
#chart-wrap.shake { animation: bearShake 0.42s ease-out; }

@keyframes hardFailureShake {
  0% { transform: translate(0, 0) scale(1); filter: hue-rotate(0deg); }
  10% { transform: translate(-3px, -3px) scale(1.004); filter: hue-rotate(-20deg) contrast(1.5); }
  20% { transform: translate(3px, 3px) scale(0.996); }
  30% { transform: translate(-4px, 2px) scale(1.006); }
  40% { transform: translate(4px, -3px) scale(0.994); }
  50% { transform: translate(-2px, 4px) scale(1.004); }
  60% { transform: translate(2px, -4px) scale(0.996); }
  70% { transform: translate(-3px, 1px) scale(1.002); }
  80% { transform: translate(3px, -1px) scale(0.998); }
  90% { transform: translate(-1px, 2px) scale(1); }
  100% { transform: translate(0, 0) scale(1); filter: hue-rotate(0deg) contrast(1); }
}
body.hard-shake { animation: hardFailureShake 0.6s cubic-bezier(.36,.07,.19,.97) both; background: #1a0505; }
</style>
</head>
<body>

<div id="header">
  <div id="logo">SPACE Z</div>
  <div id="header-divider"></div>
  <div class="h-stat"><div class="h-stat-label">현재가</div><div class="h-stat-value" id="price-el">10,000</div></div>
  <div class="h-stat"><div class="h-stat-label">실시간 수익률</div><div class="h-stat-value" id="returns-el">—</div></div>
  <div class="h-stat"><div class="h-stat-label">총 자산</div><div class="h-stat-value" id="assets-el">100,000</div></div>

  <div class="h-stat" id="principal-stat" style="display: none;">
    <div class="h-stat-label">투자 원금</div>
    <div class="h-stat-value" id="principal-el">—</div>
  </div>

  <div class="h-stat"><div class="h-stat-label">배율</div><div class="h-stat-value" id="leverage-el">×1</div></div>
  
  <button id="chart-toggle">봉차트</button>
  <div id="live-wrap"><div id="live-dot"></div>LIVE</div>
</div>

<div id="chart-wrap">
  <canvas id="chart"></canvas>
  <div id="lev-badge">LEV ×1</div>
  <div id="operator-prob"></div>
  <div id="operator-warning">
    <span class="warn-text">⚠️ 작전세력 개입 포착! (HIGH RISK)</span>
    <span class="warn-sub">■ FEVER TIME ACTIVATED ■</span>
  </div>
</div>

<div id="bottom">
  <button class="btn-trade" id="btn-buy">▲ 전액 매수</button>
  <div id="hold-strip">
    <div class="hs-item"><div class="hs-label">평균단가</div><div class="hs-val" id="hs-avg">—</div></div>
    <div class="hs-item"><div class="hs-label">수량</div><div class="hs-val" id="hs-qty">—</div></div>
    <div class="hs-item"><div class="hs-label">평가금</div><div class="hs-val" id="hs-eval">—</div></div>
  </div>
  <button class="btn-trade" id="btn-sell" disabled>▼ 전액 매도</button>
</div>

<div id="news-banner">
  <div id="news-body">
    <div id="news-tag">📰 긴급 뉴스</div>
    <div id="news-headline">헤드라인</div>
    <div id="news-effect">▲ 강세 효과 발동 중...</div>
  </div>
</div>

<div id="toast"><div id="toast-main"></div><div id="toast-sub"></div></div>
<div id="flash"></div>
<button id="shop-btn" title="상점">🛒</button>

<div id="shop-overlay">
  <div id="shop-modal">
    <div id="shop-header">
      <div class="shop-header-top">
        <div id="shop-title">SHOP</div>
        <button id="shop-close">✕</button>
      </div>
      <div class="shop-tabs">
        <button class="shop-tab active" data-target="general">일반 아이템</button>
        <button class="shop-tab" data-target="depts" style="color:var(--accent);">🔥 부서 강화</button>
      </div>
    </div>
    <div id="shop-cash">보유 현금: <span id="shop-cash-val">100,000원</span></div>
    <div id="shop-items"></div>
  </div>
</div>

<script>
const G = {
  cash:      100000,
  shares:    0,
  avgPrice:  0,
  price:     10000,
  history:   [],
  maxHist:   120,
  leverage:      1,
  bullBonus:     0,
  newsActive:    false,
  newsIsBull:    false,
  newsTicksLeft: 0,
  newsMaxTicks:  0,
  newsMultiplier: 1.0,
  baseBullProb:  0.52,
  buyLockoutActive: false,
  sellLockoutActive: false,
  isUpgrading: false,
  chartType: 'candle', // 봉차트 vs 그래프차트 상태 (기본값: candle)

  // ── 작전세력 이벤트 상태 ──
  operatorActive: false,
  operatorTicksLeft: 0,

  depts: {
    marketing: 0,
    rnd: 0,
    risk: 0,
    insider: 0
  }
};

const LEV_TIERS = [
  { lev:2, price:50000,   label:'×2 레버리지 상품 권한' },
  { lev:3, price:100000,  label:'×3 레버리지 상품 권한' },
  { lev:4, price:200000,  label:'×4 레버리지 상품 권한' },
  { lev:5, price:400000,  label:'×5 레버리지 상품 권한' },
];

const MASSIVE_BULL_NEWS = [
  { headline: '사우디 국부펀드, 한국 K-미래산업에 500조 원 전격 투자 확정 — 증시 폭등 랠리', effect: '▲▲ 초강력 급등 랠리 진행 중', multiplier: 1.5 },
  { headline: '미 연준 긴급 FOMC 개최, 예상 밖 빅컷(0.5%p) 단행 — 글로벌 증시 환호성', effect: '▲▲ 초강력 급등 랠리 진행 중', multiplier: 1.5 },
  { headline: '국내 연구진, 암세포 100% 사멸 신물질 세계 최초 개발 — FDA 패스트트랙 승인', effect: '▲▲ 초강력 급등 랠리 진행 중', multiplier: 1.5 }
];
const NORMAL_BULL_NEWS = [
  { headline: '3분기 영업이익 전년비 450% 폭증 어닝 서프라이즈… 기관 풀매수 포착', effect: '▲ 강세 효과 발동 중', multiplier: 1.0 },
  { headline: '글로벌 빅테크 기업과 5조 규모 독점 공급 계약 체결 공시 — 장중 상한가 터치', effect: '▲ 강세 효과 발동 중', multiplier: 1.0 },
  { headline: '애플, 한국 핵심 부품사 전격 인수 타진설 솔솔… 관련 테마주 매수세 폭발', effect: '▲ 강세 효과 발동 중', multiplier: 1.0 },
  { headline: '정부, K-배터리 및 반도체 100조 원 금융 지원 패키지 전격 발표', effect: '▲ 강세 효과 발동 중', multiplier: 1.0 },
  { headline: '가상화폐 비트코인 사상 최고가 돌파 신기록! 관련주 동반 급등세', effect: '▲ 강세 효과 발동 중', multiplier: 1.0 },
  { headline: '대주주, 3천억 규모 자사주 매입 및 전량 소각 깜짝 발표... 주주가치 제고', effect: '▲ 강세 효과 발동 중', multiplier: 1.0 },
  { headline: '꿈의 기술 전고체 배터리 상용화 앞당긴다… 핵심 특허 취득 소식에 들썩', effect: '▲ 강세 효과 발동 중', multiplier: 1.0 },
  { headline: 'K-뷰티 미국 아마존 싹쓸이 현상… 화장품 섹터 역대급 호황기 진입', effect: '▲ 강세 효과 발동 중', multiplier: 1.0 }
];
const WEAK_BULL_NEWS = [
  { headline: '모건스탠리, "한국 증시 저평가 구간" 투자의견 비중확대로 상향', effect: '▲ 단기 반등세 감지', multiplier: 0.7 },
  { headline: '장 막판 정체불명의 외국인 대량 순매수 유입… 바닥 다지기 들어가나', effect: '▲ 단기 반등세 감지', multiplier: 0.7 },
  { headline: '자회사 나스닥 상장 예비심사 통과 임박 찌라시 확산', effect: '▲ 단기 반등세 감지', multiplier: 0.7 },
  { headline: '낙폭 과대 인식 확산… 개미들 저가 매수세 유입되며 소폭 반등 성공', effect: '▲ 단기 반등세 감지', multiplier: 0.7 }
];

const MASSIVE_BEAR_NEWS = [
  { headline: '중국 최대 부동산 그룹 최종 부도 처리… 제2의 리먼 사태 공포에 증시 패닉셀', effect: '▼▼ 시장 붕괴급 패닉셀 발생', multiplier: 1.5 },
  { headline: '시총 5조 기업, 1조 원대 초대형 분식회계 발각… 검찰 압수수색 및 거래정지 임박', effect: '▼▼ 시장 붕괴급 패닉셀 발생', multiplier: 1.5 },
  { headline: '중동 전면전 발발 우려 최고조… 국제 유가 폭등하며 나스닥 선물 붕괴', effect: '▼▼ 시장 붕괴급 패닉셀 발생', multiplier: 1.5 }
];
const NORMAL_BEAR_NEWS = [
  { headline: '어닝 쇼크! 3분기 영업이익 적자 전환… 실망한 외인 물량 폭탄 쏟아져', effect: '▼ 약세 투심 악화 중', multiplier: 1.0 },
  { headline: '자금난 이기지 못하고 5천억 규모 주주배정 유상증자 기습 공시... 시간외 하한가', effect: '▼ 약세 투심 악화 중', multiplier: 1.0 },
  { headline: '재무담당 핵심 임원 500억 횡령 후 해외 도주… 신뢰도 바닥 치며 투매 폭발', effect: '▼ 약세 투심 악화 중', multiplier: 1.0 },
  { headline: '금융당국, 불법 공매도 및 테마주 시세조종 전면 압수수색 착수', effect: '▼ 약세 투심 악화 중', multiplier: 1.0 },
  { headline: '미국, 한국산 주요 수출품에 25% 보복 관세 부과 예고… 수출주 초비상', effect: '▼ 약세 투심 악화 중', multiplier: 1.0 },
  { headline: '대주주 및 임원진, 고점 논란 속 지분 전량 블록딜(시간외 대량매매) 엑시트', effect: '▼ 약세 투심 악화 중', multiplier: 1.0 },
  { headline: '글로벌 임상 3상 최종 실패 공식 발표… 바이오 섹터 연쇄 하한가 공포', effect: '▼ 약세 투심 악화 중', multiplier: 1.0 },
  { headline: '美 CPI 예상치 대폭 상회… 연준 매파적 발언에 금리 인상 공포 재점화', effect: '▼ 약세 투심 악화 중', multiplier: 1.0 }
];
const WEAK_BEAR_NEWS = [
  { headline: '주요 증권사, "단기 과열 징후 농후" 리포트 발간하며 목표주가 일제히 하향', effect: '▼ 단기 조정 국면 진입', multiplier: 0.7 },
  { headline: '연일 급등에 따른 피로감… 기관 차익실현 매물 출회되며 소폭 조정을 받는 모습', effect: '▼ 단기 조정 국면 진입', multiplier: 0.7 },
  { headline: '핵심 신제품 출시 일정 다음 분기로 기약 없이 연기… 실망 매물 등장', effect: '▼ 단기 조정 국면 진입', multiplier: 0.7 },
  { headline: '뚜렷한 호재 부재 속 거래량 뚝 끊기며 지루한 계단식 하락세', effect: '▼ 단기 조정 국면 진입', multiplier: 0.7 }
];

const BULL_NEWS = [...MASSIVE_BULL_NEWS, ...NORMAL_BULL_NEWS, ...WEAK_BULL_NEWS];
const BEAR_NEWS = [...MASSIVE_BEAR_NEWS, ...NORMAL_BEAR_NEWS, ...WEAK_BEAR_NEWS];

const UPGRADE_COSTS = [30000, 100000, 300000, 1000000, 3000000];
const UPGRADE_PROBS = [1.0, 0.8, 0.6, 0.4, 0.2];

const DEPT_INFO = {
  marketing: { icon: '📢', name: '글로벌 마케팅팀', desc: '호재 발생빈도 +8%↑ / 호재 확률 레벨당 +2.5%' },
  rnd:       { icon: '🧪', name: '미래기술 R&D',    desc: '호재 발생 시 주가 펌핑 상한선 증가' },
  risk:      { icon: '⚖️', name: '리스크 관리실',   desc: '악재 발생 시 폭락 피해 경감 (레벨당 6%)' },
  insider:   { icon: '💰', name: '내부자 운용팀',   desc: '평상시 주가 우상향 확률 증가' }
};

const canvas = document.getElementById('chart');
const ctx    = canvas.getContext('2d');

function resizeCanvas() {
  const w = document.getElementById('chart-wrap');
  canvas.width  = w.clientWidth; canvas.height = w.clientHeight;
}
resizeCanvas(); window.addEventListener('resize', resizeCanvas);

/* ── 개발자모드 (DEVELOPER MODE) — 3초 안에 10번 클릭 ── */
let devClickTimes = [];
let devModeActive = false;

function activateDeveloperMode() {
  if (devModeActive) return;
  devModeActive = true;

  // 개발자모드: 돈 무제한
  G.cash = 999999999999;
  // 개발자모드: 부서 강화 확률 모두 100%
  for (let i = 0; i < UPGRADE_PROBS.length; i++) UPGRADE_PROBS[i] = 1.0;

  // 개발자모드 시각 표시
  const toggle = document.getElementById('chart-toggle');
  toggle.textContent = '🔧 DEV MODE';
  toggle.style.color = '#ff00de';
  toggle.style.borderColor = '#ff00de';
  toggle.style.boxShadow = '0 0 12px rgba(255,0,222,0.6)';

  showToast('🔧 개발자모드 ON', '돈 무제한 · 강화확률 100%', 'profit', 4000);
  flash('rgba(255,0,222,0.3)');
  updateUI();
  if (shopOpen) renderShopItems();
}

/* 차트 토글 이벤트 리스너 추가 */
document.getElementById('chart-toggle').addEventListener('click', (e) => {
  // 개발자모드 활성화 감지 (3초 안에 10번)
  const now = Date.now();
  devClickTimes.push(now);
  devClickTimes = devClickTimes.filter(t => now - t <= 3000);
  if (!devModeActive && devClickTimes.length >= 10) {
    activateDeveloperMode();
    devClickTimes = [];
    return;
  }

  if (devModeActive) return; // 개발자모드 활성화 시 차트 토글 비활성

  if (G.chartType === 'candle') {
    G.chartType = 'line';
    e.target.textContent = '그래프차트';
    e.target.classList.add('active-line');
  } else {
    G.chartType = 'candle';
    e.target.textContent = '봉차트';
    e.target.classList.remove('active-line');
  }
  drawChart(); // 즉시 차트 갱신
});

/* ENGINE */
function nextPrice(p) {
  // 작전세력 발동 중: 변동폭 300% + 돌발 급등락
  if (G.operatorActive) {
    const insiderBias = G.depts.insider * 0.003;
    // 평상시 drift * 3배 + shock * 3배
    const drift = (Math.random() - (0.49 - insiderBias)) * 0.066;
    const shock = Math.random() < 0.12 ? (Math.random() - 0.5) * 0.165 : 0;
    // 매 초 5% 확률 초급등/초급락 (10~20%)
    let spike = 0;
    if (Math.random() < 0.05) {
      const mag = 0.10 + Math.random() * 0.10;
      spike = Math.random() < 0.5 ? mag : -mag;
    }
    return Math.round(Math.max(100, Math.min(p * (1 + drift + shock + spike), 9999999)));
  }

  if (G.newsActive && G.newsTicksLeft > 0) {
    let force = 0;
    if (G.newsIsBull) {
      const maxBonus = G.depts.rnd * 0.005;
      force = G.buyLockoutActive
        ? (0.03 + Math.random() * (0.03 + maxBonus))
        : (0.0068 + Math.random() * (0.0102 + maxBonus));
    } else {
      const riskMitigation = 1 - (G.depts.risk * 0.06);
      force = (G.newsTicksLeft === G.newsMaxTicks)
        ? -(0.10 + Math.random() * 0.10) * riskMitigation
        : -(0.008 + Math.random() * 0.012) * riskMitigation;
    }
    force = force * G.newsMultiplier;
    G.newsTicksLeft--;
    if (G.newsTicksLeft === 0) G.newsActive = false;
    return Math.round(Math.max(100, Math.min(p * (1 + force), 9999999)));
  }

  const insiderBias = G.depts.insider * 0.003;
  const drift = (Math.random() - (0.49 - insiderBias)) * 0.022;
  const shock = Math.random() < 0.06 ? (Math.random() - 0.5) * 0.055 : 0;
  return Math.round(Math.max(100, Math.min(p * (1 + drift + shock), 9999999)));
}

G.history = [10000];
for (let i = 1; i < G.maxHist; i++) G.history.push(nextPrice(G.history[i-1]));
G.price = G.history[G.history.length - 1];

/* RENDER */
function drawChart() {
  const W = canvas.width, H = canvas.height; 
  ctx.clearRect(0, 0, W, H);
  const data = G.history; 
  if (data.length < 2) return;

  if (G.chartType === 'candle') {
    // ── 기존 봉차트 렌더링 로직 ──
    const candles = [];
    for (let i = 0; i < data.length; i++) {
      const open = i === 0 ? data[0] : data[i-1];
      const close = data[i];
      let diff = Math.abs(close - open);
      if (diff === 0) diff = close * 0.0004;

      const seed1 = Math.abs(Math.sin(i * 12.9898 + close * 78.233)) * 43758.5453;
      const rand1 = seed1 - Math.floor(seed1);
      const seed2 = Math.abs(Math.cos(i * 45.164 + open * 27.451)) * 43758.5453;
      const rand2 = seed2 - Math.floor(seed2);

      const high = Math.max(open, close) + diff * (0.15 + rand1 * 0.4);
      let low = Math.min(open, close) - diff * (0.15 + rand2 * 0.4);
      if (low < 0) low = 0;

      candles.push({ open, high, low, close });
    }

    const mins = candles.map(c => c.low);
    const maxs = candles.map(c => c.high);
    const min = Math.min(...mins) * 0.97;
    const max = Math.max(...maxs) * 1.03;
    const rng = max - min || 1;
    
    const pad = {t:36, b:28, l:8, r:64};
    const cW  = W - pad.l - pad.r, cH  = H - pad.t - pad.b;
    
    const toX = i => pad.l + (i / (G.maxHist - 1)) * cW;
    const toY = v => pad.t + cH - ((v - min) / rng) * cH;
    const off = G.maxHist - candles.length;

    ctx.fillStyle = '#2a3a5a'; 
    ctx.font = '9px Share Tech Mono,monospace'; 
    ctx.textAlign = 'left';
    for (let g = 0; g <= 4; g++) {
      const y = pad.t + (g / 4) * cH;
      ctx.strokeStyle = 'rgba(26,32,53,0.9)'; 
      ctx.beginPath(); 
      ctx.moveTo(pad.l, y); 
      ctx.lineTo(W - pad.r + 4, y); 
      ctx.stroke();
      ctx.fillText(Math.round(max - (g / 4) * rng).toLocaleString(), W - pad.r + 8, y + 3);
    }

    if (G.shares > 0 && G.avgPrice > 0) {
      const ay = toY(G.avgPrice);
      ctx.strokeStyle = 'rgba(255,215,64,0.55)'; 
      ctx.setLineDash([5,4]); 
      ctx.beginPath(); 
      ctx.moveTo(pad.l, ay); 
      ctx.lineTo(W - pad.r, ay); 
      ctx.stroke(); 
      ctx.setLineDash([]);
      ctx.fillStyle = '#ffd740'; 
      ctx.fillText('AVG ' + Math.round(G.avgPrice).toLocaleString(), pad.l + 4, ay - 4);
    }

    for (let i = 0; i < candles.length; i++) {
      const c = candles[i];
      const x = toX(off + i);
      const yOpen = toY(c.open);
      const yClose = toY(c.close);
      const yHigh = toY(c.high);
      const yLow = toY(c.low);

      const isBull = c.close >= c.open;
      const color = isBull ? '#00e676' : '#ff1744';

      ctx.strokeStyle = color;
      ctx.fillStyle = color;
      ctx.lineWidth = 1.5;

      ctx.beginPath();
      ctx.moveTo(x, yHigh);
      ctx.lineTo(x, yLow);
      ctx.stroke();

      const bodyHeight = Math.abs(yClose - yOpen);
      const bodyWidth = Math.max(2, (cW / G.maxHist) * 0.65); 
      const bodyX = x - bodyWidth / 2;
      const bodyY = Math.min(yOpen, yClose);

      if (bodyHeight < 1.5) {
        ctx.beginPath();
        ctx.moveTo(bodyX, bodyY);
        ctx.lineTo(bodyX + bodyWidth, bodyY);
        ctx.stroke();
      } else {
        ctx.fillRect(bodyX, bodyY, bodyWidth, bodyHeight);
      }
    }
  } else {
    // ── 제공받은 그래프차트(Line) 렌더링 로직 ──
    const min = Math.min(...data) * 0.96; 
    const max = Math.max(...data) * 1.04;
    const rng = max - min || 1; 
    const pad = {t:36, b:28, l:8, r:64};
    const cW  = W - pad.l - pad.r, cH  = H - pad.t - pad.b;
    const toX = i => pad.l + (i / (G.maxHist - 1)) * cW;
    const toY = v => pad.t + cH - ((v - min) / rng) * cH;
    const off = G.maxHist - data.length;

    ctx.fillStyle = '#2a3a5a'; 
    ctx.font = '9px Share Tech Mono,monospace'; 
    ctx.textAlign = 'left';
    for (let g = 0; g <= 4; g++) {
      const y = pad.t + (g / 4) * cH;
      ctx.strokeStyle = 'rgba(26,32,53,0.9)'; 
      ctx.beginPath(); 
      ctx.moveTo(pad.l, y); 
      ctx.lineTo(W - pad.r + 4, y); 
      ctx.stroke();
      ctx.fillText(Math.round(max - (g / 4) * rng).toLocaleString(), W - pad.r + 8, y + 3);
    }

    if (G.shares > 0 && G.avgPrice > 0) {
      const ay = toY(G.avgPrice);
      ctx.strokeStyle = 'rgba(255,215,64,0.55)'; 
      ctx.setLineDash([5,4]); 
      ctx.beginPath(); 
      ctx.moveTo(pad.l, ay); 
      ctx.lineTo(W - pad.r, ay); 
      ctx.stroke(); 
      ctx.setLineDash([]);
      ctx.fillStyle = '#ffd740'; 
      ctx.fillText('AVG ' + Math.round(G.avgPrice).toLocaleString(), pad.l + 4, ay - 4);
    }

    const isUp = data[data.length - 1] >= data[0];
    const lineClr = isUp ? '#00e676' : '#ff1744';
    const grad = ctx.createLinearGradient(0, pad.t, 0, H - pad.b);
    grad.addColorStop(0, isUp ? 'rgba(0,230,118,0.2)' : 'rgba(255,23,68,0.18)');
    grad.addColorStop(1, 'rgba(0,0,0,0.01)');

    ctx.beginPath(); ctx.moveTo(toX(off), toY(data[0]));
    for (let i = 1; i < data.length; i++) ctx.bezierCurveTo((toX(off+i-1)+toX(off+i))/2, toY(data[i-1]), (toX(off+i-1)+toX(off+i))/2, toY(data[i]), toX(off+i), toY(data[i]));
    ctx.lineTo(toX(off + data.length - 1), H - pad.b); ctx.lineTo(toX(off), H - pad.b); ctx.fillStyle = grad; ctx.fill();

    ctx.beginPath(); ctx.moveTo(toX(off), toY(data[0]));
    for (let i = 1; i < data.length; i++) ctx.bezierCurveTo((toX(off+i-1)+toX(off+i))/2, toY(data[i-1]), (toX(off+i-1)+toX(off+i))/2, toY(data[i]), toX(off+i), toY(data[i]));
    ctx.strokeStyle = lineClr; ctx.lineWidth = 2; ctx.stroke();

    const dx = toX(off + data.length - 1), dy = toY(data[data.length-1]);
    ctx.beginPath(); ctx.arc(dx, dy, 5, 0, Math.PI*2); ctx.fillStyle = lineClr; ctx.fill();
  }
}

const fmt = n => Math.round(n).toLocaleString('ko-KR');

/* ⚡ 핵심 수식 처리 파트 */
function getLeveragedData() {
  if (G.shares <= 0 || G.avgPrice <= 0) return { pct: 0, currentEval: 0 };

  const rawPct = ((G.price - G.avgPrice) / G.avgPrice * 100);
  const pct = rawPct * G.leverage;
  const principal = G.shares * G.avgPrice;
  const currentEval = principal * (1 + (pct / 100));

  return { pct, currentEval };
}

function updateUI() {
  document.getElementById('price-el').textContent = fmt(G.price) + '원';

  const levData = getLeveragedData();

  const totalAssets = G.cash + (G.shares > 0 ? Math.max(0, levData.currentEval) : 0);
  document.getElementById('assets-el').textContent = fmt(totalAssets) + '원';

  const principalStat = document.getElementById('principal-stat');
  if (G.shares > 0) {
    principalStat.style.display = 'flex';
    const principal = G.shares * G.avgPrice;
    document.getElementById('principal-el').textContent = fmt(principal) + '원';
  } else {
    principalStat.style.display = 'none';
  }

  const returnsEl = document.getElementById('returns-el');
  if (G.shares > 0) {
    returnsEl.textContent = (levData.pct >= 0 ? '+' : '') + levData.pct.toFixed(2) + '%';
    returnsEl.className = 'h-stat-value ' + (levData.pct >= 0 ? 'up' : 'dn');
  } else {
    returnsEl.textContent = '—'; returnsEl.className = 'h-stat-value';
  }

  document.getElementById('leverage-el').textContent = '×' + G.leverage;
  const strip = document.getElementById('hold-strip');
  if (G.shares > 0) {
    strip.classList.add('visible');
    document.getElementById('hs-avg').textContent  = fmt(G.avgPrice) + '원';
    document.getElementById('hs-qty').textContent  = G.shares.toFixed(4) + '주';
    document.getElementById('hs-eval').textContent = fmt(Math.max(0, levData.currentEval)) + '원';
  } else strip.classList.remove('visible');

  document.getElementById('shop-cash-val').textContent = fmt(G.cash) + '원';

  // ── 상점이 열려있을 때 버튼 활성/비활성만 업데이트 (DOM 재생성 없이) ──
  if (shopOpen && !G.isUpgrading) {
    updateShopButtonStates();
  }

  const levBadge = document.getElementById('lev-badge');
  if (G.leverage > 1) { levBadge.textContent = 'LEV ×' + G.leverage; levBadge.classList.add('visible'); }
  else levBadge.classList.remove('visible');

  // ── 작전세력 등장확률 배지 업데이트 ──
  const opProb = document.getElementById('operator-prob');
  // 총자산 기준 (매수 중엔 cash=0이므로 평가금 포함)
  const levDataBadge = getLeveragedData();
  const totalAssetsBadge = G.cash + (G.shares > 0 ? Math.max(0, levDataBadge.currentEval) : 0);
  if (totalAssetsBadge >= 10000000000) { // 100억
    opProb.textContent = '작전세력 등장확률: 5%';
    opProb.style.display = 'block';
  } else if (totalAssetsBadge >= 1000000000) { // 10억
    opProb.textContent = '작전세력 등장확률: 2%';
    opProb.style.display = 'block';
  } else if (totalAssetsBadge >= 100000000) { // 1억
    opProb.textContent = '작전세력 등장확률: 1%';
    opProb.style.display = 'block';
  } else {
    opProb.style.display = 'none';
  }

  const buyBtn = document.getElementById('btn-buy');
  if (G.buyLockoutActive) { buyBtn.disabled = true; buyBtn.classList.add('lock-disabled'); }
  else if (G.cash <= 0) { buyBtn.disabled = true; buyBtn.classList.remove('lock-disabled'); }
  else { buyBtn.disabled = false; buyBtn.classList.remove('lock-disabled'); }
}

// ── 상점 버튼 상태만 업데이트 (DOM 재생성 없이 — 4강/5강 애니메이션 유지) ──
function updateShopButtonStates() {
  if (shopState.tab === 'general') {
    const levBtn = document.getElementById('buy-lev');
    const nextTier = LEV_TIERS[shopState.levIndex];
    if (levBtn && nextTier) levBtn.disabled = G.cash < nextTier.price;
    const boostBtn = document.getElementById('buy-boost');
    if (boostBtn) boostBtn.disabled = G.cash < 200000;
  } else {
    Object.keys(DEPT_INFO).forEach(key => {
      const level = G.depts[key];
      const btn = document.getElementById(`upg-${key}`);
      if (btn && level < 5) {
        const cost = UPGRADE_COSTS[level];
        btn.disabled = G.cash < cost || G.isUpgrading;
      }
    });
  }
}

/* ACTIONS */
document.getElementById('btn-buy').addEventListener('click', () => {
  if (G.cash <= 0 || G.buyLockoutActive) return;

  G.shares = G.cash / G.price;
  G.avgPrice = G.price;
  G.cash = 0;

  document.getElementById('btn-buy').disabled = true; document.getElementById('btn-sell').disabled = false;
  flash('rgba(0,230,118,0.15)');
  showToast('▲ 매수 체결', `@ ${fmt(G.avgPrice)}원 (LEV ×${G.leverage} 상품)`, 'profit');
  updateUI();
});

document.getElementById('btn-sell').addEventListener('click', () => {
  if (G.shares <= 0 || G.sellLockoutActive) return;

  const levData = getLeveragedData();
  const principal = G.shares * G.avgPrice;
  const pnl = levData.currentEval - principal;

  G.cash = Math.max(0, levData.currentEval);
  G.shares = 0;
  G.avgPrice = 0;

  document.getElementById('btn-buy').disabled = false; document.getElementById('btn-sell').disabled = true;
  flash(pnl >= 0 ? 'rgba(0,230,118,0.15)' : 'rgba(255,23,68,0.12)');
  showToast(pnl >= 0 ? '▲ 실현 이익' : '▼ 실현 손실', `${fmt(pnl)}원`, pnl >= 0 ? 'profit' : 'loss', 5000);
  updateUI();
});

let toastTmr = null;
function showToast(main, sub, type, duration = 2500) {
  const el = document.getElementById('toast');
  document.getElementById('toast-main').textContent = main; document.getElementById('toast-sub').textContent = sub;
  el.className = 'show ' + type; if (toastTmr) clearTimeout(toastTmr);
  toastTmr = setTimeout(() => { el.className = ''; }, duration);
}

function flash(clr) {
  const el = document.getElementById('flash'); el.style.background = clr; el.style.opacity = '1';
  setTimeout(() => { el.style.opacity = '0'; }, 180);
}

/* NEWS SYS */
let newsTimer = null;
function scheduleNews() {
  const timeReduction = Math.pow(0.92, G.depts.marketing);
  const baseTime = 18000;
  const randTime = 15000;
  newsTimer = setTimeout(triggerNews, (baseTime + Math.random() * randTime) * timeReduction);
}

let newsHideTimer = null;
function triggerNews() {
  const banner = document.getElementById('news-banner');
  const marketingBullBonus = G.depts.marketing * 0.025;
  const finalBullProb = Math.min(1.0, G.baseBullProb + G.bullBonus + marketingBullBonus);

  const isBull = Math.random() < finalBullProb;
  const pool = isBull ? BULL_NEWS : BEAR_NEWS;
  const item = pool[Math.floor(Math.random() * pool.length)];
  G.newsActive = true; G.newsIsBull = isBull; G.newsTicksLeft = 7 + Math.floor(Math.random() * 3); G.newsMaxTicks = G.newsTicksLeft;
  G.newsMultiplier = item.multiplier;

  if (!isBull) {
    G.sellLockoutActive = true;
    document.getElementById('btn-sell').disabled = true;
    setTimeout(() => {
      G.sellLockoutActive = false;
      if (G.shares > 0) document.getElementById('btn-sell').disabled = false;
      updateUI();
    }, 500);
    const cw = document.getElementById('chart-wrap');
    cw.classList.remove('shake'); void cw.offsetWidth; cw.classList.add('shake');
    setTimeout(() => cw.classList.remove('shake'), 450);
  }

  if (isBull) { G.buyLockoutActive = true; setTimeout(() => { G.buyLockoutActive = false; updateUI(); }, 4500); }

  const isMassive = item.multiplier >= 1.5;
  document.getElementById('news-tag').textContent = isBull
    ? (isMassive ? '🚨 초대형 호재 뉴스' : '📈 호재 뉴스')
    : (isMassive ? '🚨 초대형 악재 뉴스' : '📉 악재 뉴스');
  document.getElementById('news-headline').textContent = item.headline;
  document.getElementById('news-effect').textContent = item.effect;

  let bannerClass = 'show ' + (isBull ? 'bull' : 'bear');
  if (isMassive) bannerClass += ' massive';
  banner.className = bannerClass;
  updateUI();

  if(newsHideTimer) clearTimeout(newsHideTimer);
  newsHideTimer = setTimeout(() => { banner.className = ''; scheduleNews(); }, 7000);
}

/* SHOP INTERACTION */
let shopOpen = false, shopState = { levIndex: 0, partnerBought: false, tab: 'general' };
function openShop()  { shopOpen=true; document.getElementById('shop-overlay').classList.add('open'); renderShopItems(); }
function closeShopAction() { document.getElementById('shop-overlay').classList.remove('open'); shopOpen=false; }
document.getElementById('shop-btn').addEventListener('click', () => shopOpen ? closeShopAction() : openShop());
document.getElementById('shop-close').addEventListener('click', closeShopAction);

document.querySelectorAll('.shop-tab').forEach(btn => {
  btn.addEventListener('click', (e) => {
    document.querySelectorAll('.shop-tab').forEach(b => b.classList.remove('active'));
    e.target.classList.add('active');
    shopState.tab = e.target.dataset.target;
    renderShopItems();
  });
});

function renderShopItems() {
  const container = document.getElementById('shop-items'); container.innerHTML = '';

  if (shopState.tab === 'general') {
    const nextTier = LEV_TIERS[shopState.levIndex];
    const levItem  = document.createElement('div'); levItem.className = 'shop-item';
    if (nextTier) {
      levItem.innerHTML = `<div class="item-row"><div class="item-icon">⚡</div><div class="item-info"><div class="item-name">${nextTier.label}</div><div class="item-desc">현재 취급 정품: ×${G.leverage} 배율</div><div class="item-price">💰 ${fmt(nextTier.price)}원</div></div><button class="item-buy-btn yellow-btn" id="buy-lev" ${G.cash>=nextTier.price?'':'disabled'}>구매</button></div>`;
      levItem.querySelector('#buy-lev').addEventListener('click', () => { G.cash -= nextTier.price; G.leverage = nextTier.lev; shopState.levIndex++; updateUI(); closeShopAction(); });
    } else levItem.innerHTML = `<div class="item-row"><div class="item-icon">⚡</div><div class="item-info"><div class="item-name">레버리지 MAX</div></div><button class="item-buy-btn yellow-btn" disabled>완료</button></div>`;
    container.appendChild(levItem);

    const boostItem = document.createElement('div'); boostItem.className = 'shop-item';
    if (shopState.partnerBought) boostItem.innerHTML = `<div class="item-row"><div class="item-icon">🤝</div><div class="item-info"><div class="item-name">파트너십 완료</div></div><button class="item-buy-btn yellow-btn" disabled>보유중</button></div>`;
    else {
      boostItem.innerHTML = `<div class="item-row"><div class="item-icon">🤝</div><div class="item-info"><div class="item-name">기업 파트너십</div><div class="item-desc">호재 발생 확률 +7% 증가</div><div class="item-price">💰 200,000원</div></div><button class="item-buy-btn yellow-btn" id="buy-boost" ${G.cash>=200000?'':'disabled'}>구매</button></div>`;
      boostItem.querySelector('#buy-boost').addEventListener('click', () => { G.cash -= 200000; G.bullBonus += 0.07; shopState.partnerBought = true; updateUI(); closeShopAction(); });
    }
    container.appendChild(boostItem);
  } else {
    Object.keys(DEPT_INFO).forEach(key => {
      const info = DEPT_INFO[key];
      const level = G.depts[key];
      const itemEl = document.createElement('div');
      itemEl.className = `shop-item tier-${level}`;

      let rightBtnHtml = '';
      if (level < 5) {
        const cost = UPGRADE_COSTS[level];
        const probPct = UPGRADE_PROBS[level] * 100;
        rightBtnHtml = `<div style="display:flex; flex-direction:column; align-items:flex-end;">
          <button class="item-buy-btn yellow-btn" id="upg-${key}" ${G.cash>=cost?'':'disabled'}>시도 (💰${fmt(cost)})</button>
          <div class="prob-text">성공률: ${probPct}%</div>
        </div>`;
      } else {
        rightBtnHtml = `<div class="prob-text" style="color:var(--purple); font-weight:900; font-size:12px;">MAX LEVEL</div>`;
      }

      itemEl.innerHTML = `
        <div class="item-row">
          <div class="item-icon">${info.icon}</div>
          <div class="item-info">
            <div class="item-name">${info.name} <span class="level-badge">+${level}</span></div>
            <div class="item-desc">${info.desc}</div>
          </div>
          ${rightBtnHtml}
        </div>
      `;

      container.appendChild(itemEl);

      // tier-5: ember 파티클 주입
      if (level === 5) {
        for (let e = 0; e < 6; e++) {
          const ember = document.createElement('div');
          ember.className = 't5-ember';
          itemEl.appendChild(ember);
        }
      }

      const btn = itemEl.querySelector(`#upg-${key}`);
      if (btn) {
        btn.addEventListener('click', () => attemptUpgrade(key, btn));
      }
    });
  }
}

async function attemptUpgrade(deptKey, btnEl) {
  const currentLevel = G.depts[deptKey];
  const cost = UPGRADE_COSTS[currentLevel];
  if (G.cash < cost || G.isUpgrading) return;

  G.cash -= cost;
  G.isUpgrading = true;
  updateUI();

  const itemEl = btnEl.closest('.shop-item');
  itemEl.classList.add('item-upgrading');
  btnEl.textContent = "진행중..";

  await new Promise(resolve => setTimeout(resolve, 1500));

  const prob = UPGRADE_PROBS[currentLevel];
  const isSuccess = Math.random() < prob;

  if (isSuccess) {
    G.depts[deptKey]++;
    const newLv = G.depts[deptKey];
    flash('rgba(0,230,118,0.25)');
    showToast(`✨ 강화 성공!`, `[${DEPT_INFO[deptKey].name}] +${newLv}강 달성!`, 'profit');
  } else {
    G.depts[deptKey] = 0;

    document.body.classList.remove('hard-shake');
    void document.body.offsetWidth;
    document.body.classList.add('hard-shake');
    setTimeout(() => document.body.classList.remove('hard-shake'), 600);

    flash('rgba(255,23,68,0.4)');
    showToast(`💥 강화 실패!`, `${DEPT_INFO[deptKey].name}이(가) 0강으로 파괴되었습니다...`, 'loss');
  }

  G.isUpgrading = false;
  renderShopItems();
  updateUI();
}

/* ── 작전세력 이벤트 ── */
let operatorFastTicker = null;

function triggerOperatorEvent() {
  if (G.operatorActive || G.newsActive) return;
  G.operatorActive = true;
  G.operatorTicksLeft = 7;

  // 경고 오버레이 표시
  const warn = document.getElementById('operator-warning');
  warn.classList.add('show');

  // 차트 황금 번쩍 이펙트
  const cw = document.getElementById('chart-wrap');
  cw.classList.add('fever');

  // 5배 빠른 틱 (기존 1000ms → 200ms 간격)
  if (operatorFastTicker) clearInterval(operatorFastTicker);
  operatorFastTicker = setInterval(() => {
    if (!G.operatorActive) { clearInterval(operatorFastTicker); operatorFastTicker = null; return; }
    G.price = nextPrice(G.price);
    G.history.push(G.price);
    if (G.history.length > G.maxHist) G.history.shift();
    // 마진콜 체크
    if (G.shares > 0) {
      const levData = getLeveragedData();
      if (levData.pct <= -100 || levData.currentEval <= 0) {
        G.cash = 0; G.shares = 0; G.avgPrice = 0;
        document.getElementById('btn-buy').disabled = false;
        document.getElementById('btn-sell').disabled = true;
        flash('rgba(255,23,68,0.7)');
        showToast('💥 강제 청산(Margin Call)!', '수익률 -100% 도달로 자산이 강제 소멸되었습니다.', 'loss', 5000);
        document.body.classList.remove('hard-shake'); void document.body.offsetWidth; document.body.classList.add('hard-shake');
        setTimeout(() => document.body.classList.remove('hard-shake'), 600);
      }
    }
    updateUI();
  }, 200);

  // 7초 후 종료
  setTimeout(() => {
    G.operatorActive = false;
    warn.classList.remove('show');
    cw.classList.remove('fever');
    if (operatorFastTicker) { clearInterval(operatorFastTicker); operatorFastTicker = null; }
  }, 7000);
}

/* ── 거짓뉴스 이벤트 ── */
function triggerFakeNews() {
  // 호재 뉴스 즉시 취소
  G.newsActive = false;
  G.newsIsBull = false;
  G.newsTicksLeft = 0;
  G.buyLockoutActive = false;

  // 주가 즉시 20~40% 폭락
  const dropRate = 0.20 + Math.random() * 0.20;
  G.price = Math.round(Math.max(100, G.price * (1 - dropRate)));
  G.history.push(G.price);
  if (G.history.length > G.maxHist) G.history.shift();

  // 핏빛 플래시 + 차트 패닉 흔들기
  const flashEl = document.getElementById('flash');
  flashEl.className = 'blood';
  flashEl.style.opacity = '1';
  setTimeout(() => { flashEl.className = ''; flashEl.style.opacity = '0'; }, 520);

  const cw = document.getElementById('chart-wrap');
  cw.classList.remove('panic'); void cw.offsetWidth; cw.classList.add('panic');
  setTimeout(() => cw.classList.remove('panic'), 580);

  // 거짓뉴스 배너 표시
  const banner = document.getElementById('news-banner');
  document.getElementById('news-tag').textContent = '🚨 [속보] 거짓 선동 뉴스 발각';
  document.getElementById('news-headline').textContent = '이전 호재 뉴스는 작전 세력의 \'거짓 선동\'으로 밝혀져... 금감원 조사 착수';
  document.getElementById('news-effect').textContent = `▼▼ 즉시 ${Math.round(dropRate * 100)}% 수직 낙하 발생`;
  banner.className = 'show bear massive fake';

  if (newsHideTimer) clearTimeout(newsHideTimer);
  newsHideTimer = setTimeout(() => { banner.className = ''; scheduleNews(); }, 6000);

  updateUI();
}

/* LOOP & 마진콜(강제청산) 로직 */
let lastTick = Date.now();
function loop() {
  const now = Date.now();
  if (now - lastTick >= 1000) {
    // 작전세력 발동 중엔 별도 인터벌이 처리하므로 일반 틱 스킵
    if (!G.operatorActive) {
      G.price = nextPrice(G.price);
      G.history.push(G.price);
      if (G.history.length > G.maxHist) G.history.shift();
    }
    lastTick = now;

    if (G.shares > 0 && !G.operatorActive) {
      const levData = getLeveragedData();

      if (levData.pct <= -100 || levData.currentEval <= 0) {
        G.cash = 0;
        G.shares = 0;
        G.avgPrice = 0;

        document.getElementById('btn-buy').disabled = false;
        document.getElementById('btn-sell').disabled = true;

        flash('rgba(255,23,68,0.7)');
        showToast('💥 강제 청산(Margin Call)!', `수익률 -100% 도달로 자산이 강제 소멸되었습니다.`, 'loss', 5000);

        document.body.classList.remove('hard-shake');
        void document.body.offsetWidth;
        document.body.classList.add('hard-shake');
        setTimeout(() => document.body.classList.remove('hard-shake'), 600);
      }
    }

    // ── 작전세력 발동 확률 체크 (매수 중, 이벤트 없을 때만) ──
    if (G.shares > 0 && !G.operatorActive && !G.newsActive) {
      // 총자산 기준 (매수 중엔 cash=0이므로 평가금 포함해야 발동됨)
      const levDataOp = getLeveragedData();
      const totalAssetsOp = G.cash + (G.shares > 0 ? Math.max(0, levDataOp.currentEval) : 0);
      let opChance = 0;
      if (totalAssetsOp >= 10000000000) opChance = 0.05;
      else if (totalAssetsOp >= 1000000000) opChance = 0.02;
      else if (totalAssetsOp >= 100000000) opChance = 0.01;
      if (opChance > 0 && Math.random() < opChance) {
        triggerOperatorEvent();
      }
    }

    // ── 거짓뉴스 발동 확률 체크 (호재 뉴스 발동 중, 매수 중일 때) ──
    if (G.newsActive && G.newsIsBull && G.shares > 0 && !G.operatorActive) {
      if (Math.random() < 0.03) {
        triggerFakeNews();
      }
    }

    updateUI();
  }
  drawChart(); requestAnimationFrame(loop);
}

updateUI(); scheduleNews(); loop();
</script>
</body>
</html>
